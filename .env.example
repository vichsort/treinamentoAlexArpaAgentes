# Atendimento por GitHub Actions. Copie para .env (ignorado pelo git) e preencha localmente.
AGENT_RUNTIME=github-actions
AGENT_DRY_RUN=true
GITHUB_REPO=dono/repositorio
# Credencial só do backend: cria a issue, dispara o workflow e lê o estado. Nunca o GITHUB_TOKEN das Actions.
# PAT com Issues e Actions (escrita) neste repositório.
GITHUB_ISSUES_TOKEN=
# Segredo longo e aleatório; o MESMO valor vai no Secret AGENT_LINK_SECRET do repositório.
AGENT_LINK_SECRET=
# Na IA (Actions): variáveis AI_PROVIDER, AI_MODEL, AI_BASE_URL (opcional) e o Secret AI_API_KEY ficam no GitHub, não aqui.
